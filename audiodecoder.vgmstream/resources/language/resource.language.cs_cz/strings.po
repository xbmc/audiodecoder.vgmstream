msgctxt "#30000"
msgid "Loop forever"
msgstr "Opakovat donekonečna"

msgctxt "#30001"
msgid "Some vgmstream audio files use infinite playback, if disabled it will stop after the first round."
msgstr "Některé zvukové soubory vgmstream používají nekonečné přehrávání; pokud je tato volba vypnutá, přehrávání se zastaví po prvním průchodu."

msgctxt "#30002"
msgid "Endless playback starts"
msgstr "Začátek nekonečného přehrávání"
