msgctxt "#30000"
msgid "Loop forever"
msgstr "Oändlig slinga"

msgctxt "#30001"
msgid "Some vgmstream audio files use infinite playback, if disabled it will stop after the first round."
msgstr "Vissa vgmstream-ljudfiler använder oändlig uppspelning, om den är inaktiverad kommer den att sluta efter första omgången."

msgctxt "#30002"
msgid "Endless playback starts"
msgstr "Oändlig uppspelning startar"
